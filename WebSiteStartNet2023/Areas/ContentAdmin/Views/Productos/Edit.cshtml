@model WebSiteStartNet2023.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<h1>Editar Producto</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group" style="display:none;">
                <label asp-for="NombreSlider" class="control-label"></label>
                <input asp-for="NombreSlider" class="form-control" value="Vacio" />
                <span asp-validation-for="NombreSlider" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FotoSlider" class="control-label"></label>
                <input asp-for="FotoSlider" accept="image/*" class="form-control" required="true" />
                <span asp-validation-for="FotoSlider" class="text-danger"></span>
            </div>
            <div class="form-group" style="display:none;">
                <label asp-for="NombreHome" class="control-label"></label>
                <input asp-for="NombreHome" class="form-control" value="Vacio" />
                <span asp-validation-for="NombreHome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FotoHome" class="control-label"></label>
                <input asp-for="FotoHome" accept="image/*" class="form-control" required="true" />
                <span asp-validation-for="FotoHome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Detalle" class="control-label"></label>
                <textarea name="Detalle" id="tiny" class="form-control"></textarea>
                <span asp-validation-for="Detalle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <br />
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver</a>
</div>
<hr />
