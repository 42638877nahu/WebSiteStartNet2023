@model IEnumerable<WebSiteStartNet2023.Models.ModelView.PostulanteIndexVM>

@{
    ViewData["Title"] = "Index";
}

<div class="mx-2 mt-5 mb-5">
    <a asp-action="Create" class="btn btn-success">Nuevo Postulante</a>
</div>

<div class="mx-2">
    <form asp-action="Index" method="get">
        <div class="form-group">
            <label>Filtros</label>

            <div class="row">
                <div class="col-sm-10 col-md-4">
                    <div class="form-group">
                        <select name="TecnologiaId" class="form-control">
                            <option value="">-- Todas las tecnologias --</option>
                            @foreach (var Tecno in ViewBag.Tecnologias)
                            {
                                <option value="@Tecno.Id">@Tecno.Nombre</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-sm-2 col-md-2">
                    <button type="submit" class="btn btn-light">
                        <i class="bi bi-search" ></i>Buscar
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="mt-3" style="overflow-x: auto">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
                <th>Fecha Nacimiento</th>
                <th>Localidad</th>
                <th>CodigoArea</th>
                <th>Telefono/Celular</th>
                <th>Email</th>
                <th>ArchivoCV</th>
                <th>FechaAlta</th>
                <th>Idioma</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.Apellido)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.DNI)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.FechaNacimiento)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreLocalidadPostulante)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.CodigoArea)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.TelefonoCelular)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.ArchivoCV)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Postulante.FechaAlta)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreIdioma)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Postulante.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Postulante.Id">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Postulante.Id">eliminar</a>
                </td>
            </tr>
            }

        </tbody>
    </table>
</div>