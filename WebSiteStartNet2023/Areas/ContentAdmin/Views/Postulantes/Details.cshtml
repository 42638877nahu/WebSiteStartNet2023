@model WebSiteStartNet2023.Models.ModelView.PostulanteIndexVM

@{
    ViewData["Title"] = "Detalles";
}

<div>
    <h4>Postulante</h4>
    <hr />
    <div class="row">    
        <div class="col-6">
            <dl class="row">
                <dt class="col-sm-4">
                    Nombre: 
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.Nombre)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.Apellido):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.Apellido)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.DNI):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.DNI)
                </dd>

                <dt class="col-sm-4">
                    Fecha de nacimiento:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.FechaNacimiento)
                </dd>

                <dt class="col-sm-4">
                    Localidad:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreLocalidadPostulante)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.CodigoArea):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.CodigoArea)
                </dd>

                <dt class="col-sm-4">
                  Telefono celular:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.TelefonoCelular)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.Email):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.Email)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.ArchivoCV):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.ArchivoCV)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Postulante.FechaAlta):
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Postulante.FechaAlta)
                </dd>

            </dl>

        </div>
        <div class="col-6">
            <dl class="row">
                <dt class="col-sm-4">
                     Tecnologia:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreTecnologia)
                </dd>
                <dt class="col-sm-4">
                    Nivel Conocimiento:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreNivelConocimiento)
                </dd>

                <dt class="col-sm-4">
                   Idioma:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreIdioma)
                </dd>
                <dt class="col-sm-4">
                    Nivel Oral:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreNivelOral)
                </dd>
                <dt class="col-sm-4">
                    Nivel Escritura:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreNivelEscritura)
                </dd>
                <dt class="col-sm-4">
                     Nivel Lectura:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreNivelLectura)
                </dd>
                <dt class="col-sm-4">
                   Puesto Trabajo:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombrePuestoTrabajo)
                </dd>
                <dt class="col-sm-4">
                    Experiencia Trabajo:
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.NombreExperienciaTrabajo)
                </dd>
                
            </dl>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Postulante.Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>
