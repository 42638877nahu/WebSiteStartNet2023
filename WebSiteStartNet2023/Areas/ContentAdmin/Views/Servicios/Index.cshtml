@model IEnumerable<WebSiteStartNet2023.Models.Servicio>

@{
    ViewData["Title"] = "Servicios";
}

<h1>Servicios</h1>

<p>
    <a asp-action="Create">Crear Servicio</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
@*            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>*@
            <th>
                @Html.DisplayName("Foto Slider")
            </th>
            <th>
                @Html.DisplayName("Foto Home")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Fecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
@*            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>*@
            <td>
                    <img width="150em" height="auto" class="img-fluid" src="~/Data/Imagenes/Servicios/@item.NombreSlider">
            </td>
            <td>
                    <img width="150em" height="auto" class="img-fluid" src="~/Data/Imagenes/Servicios/@item.NombreHome">
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
}
    </tbody>
</table>
