@model WebSiteStartNet2023.Models.Cliente

@{
    ViewData["Title"] = "Delete";
}

<h1>Borrar Cliente</h1>

<h3>Esta seguro que desea borrar este cliente?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NombreFantasia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombreFantasia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Rubro Cliente")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RubroCliente.Nombre)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Borrar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>
