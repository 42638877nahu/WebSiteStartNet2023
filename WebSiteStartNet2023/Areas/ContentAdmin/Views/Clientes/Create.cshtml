@model WebSiteStartNet2023.Models.Cliente

@{
    ViewData["Title"] = "Crear Cliente";
}

<h1>Crear Cliente</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NombreFantasia" class="control-label"></label>
                <input asp-for="NombreFantasia" class="form-control" />
                <span asp-validation-for="NombreFantasia" class="text-danger"></span>
            </div>
            <div class="form-group" style="display:none;">
                <label asp-for="NombreLogo" class="control-label"></label>
                <input asp-for="NombreLogo" class="form-control"/>
                <span asp-validation-for="NombreLogo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FotoLogo" class="control-label">Foto Logo</label>
                <input asp-for="FotoLogo" accept="image/*" class="form-control"/>
                <span asp-validation-for="FotoLogo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Orden" class="control-label"></label>
                <input asp-for="Orden" class="form-control" value="0"/>
                <span asp-validation-for="Orden" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="VisibleEnHome" /> 
                    @Html.DisplayNameFor(model => model.VisibleEnHome)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="IdRubroCliente" class="control-label">Rubro Cliente</label>
                <select asp-for="IdRubroCliente" class ="form-control" asp-items="ViewBag.IdRubroCliente"></select>
            </div>
            <div class="form-group">
                <br />
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver</a>
</div>
<hr />
