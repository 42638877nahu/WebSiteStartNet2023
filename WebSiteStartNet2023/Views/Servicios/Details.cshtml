@model WebSiteStartNet2023.Models.Servicio

@{
    ViewData["Title"] = "Details";
}
@using Microsoft.Extensions.Options
@inject IOptions<GoogleCaptchaConfig> GoogleCaptchaConfig

<div class="container-fluid position-relative p-0">
    <div class="container-fluid bg-primary py-5 bg-header">
        <div class="row py-5">
            <div class="col-12 pt-lg-5 mt-lg-5 text-center">
                <h1 class="display-4 text-white animated zoomIn">@Model.Nombre</h1>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-12">
                <div class="row g-5">
                    <div class="col-md-6 wow slideInUp" data-wow-delay="0.1s">
                        <div class="blog-item bg-light rounded overflow-hidden">
                            <div class="p-4">
                                @Html.Raw(Model.Detalle)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 wow slideInUp" data-wow-delay="0.1s">
                        <div class="blog-item bg-light rounded overflow-hidden">
                            <div class="blog-img position-relative overflow-hidden">
                                <img class="img-fluid" src="~/Data/Imagenes/Servicios/@Model.NombreHome" alt="">
                            </div>
                        </div>
                        <br />
                        <h3 style="text-align:center;">Envíenos su Consulta</h3>
                        <br />
                        <form method="post" enctype="multipart/form-data" asp-action="Contacto" asp-controller="Home">
                            <p style="color:red;">Los campos con (*) son Obligatorios</p>
                            <div class="row g-3">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <input type="hidden" id="TokenContacto" name="Token" />
                                <div class="col-md-6">
                                    <input name="Nombre" type="text" class="form-control border-0 bg-light px-4" placeholder="Nombre(*)" style="height: 55px;" required>
                                    <span name="Nombre" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input name="Apellido" type="text" class="form-control border-0 bg-light px-4" placeholder="Apellido(*)" style="height: 55px;" required>
                                    <span name="Apellido" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input name="AreaCelular" type="text" class="form-control border-0 bg-light px-4" placeholder="Area Celular(*)" style="height: 55px;" required>
                                    <span name="AreaCelular" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <input name="TeléfonoCelular" type="text" class="form-control border-0 bg-light px-4" placeholder="Celular(*)" style="height: 55px;" required>
                                    <span name="TeléfonoCelular" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <input name="Email" type="email" class="form-control border-0 bg-light px-4" placeholder="Email(*)" style="height: 55px;" required>
                                    <span name="Email" class="text-danger"></span>
                                </div>
                                <div class="col-12" style="display:none;">
                                    <input name="SubArea" value="@Model.Nombre" class="form-control border-0 bg-light px-4">
                                </div>
                                <div class="col-12">
                                    <textarea name="Mensaje" class="form-control border-0 bg-light px-4 py-3" rows="4" placeholder="Mensaje(*)" required></textarea>
                                    <span name="Mensaje" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-primary w-100 py-3" type="submit">
                                        Enviar Mensaje
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://www.google.com/recaptcha/api.js?render=@GoogleCaptchaConfig.Value.SiteKey"></script>
<script>
    document.addEventListener("DOMContentLoaded", function (event) {
        grecaptcha.ready(function () {
            grecaptcha.execute('@GoogleCaptchaConfig.Value.SiteKey', { action: 'submit' }).then(function (token) {
                // Add your logic to submit to your backend server here.
                document.getElementById("TokenContacto").value = token;
            });
        });
    });
</script>