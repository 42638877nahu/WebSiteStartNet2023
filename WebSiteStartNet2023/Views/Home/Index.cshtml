<!-- Navbar & Carousel Start -->
<div id="header-carousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-inner">
        @foreach (var item in ViewBag.Sliders)
        {
            if (item.Nombre == ViewBag.PrimerSlider.Nombre)
            {
                <div class="carousel-item active">
                    <img class="img-fluid" width="100%" src="@item.Ruta" alt="Image">
                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                        <div class="p-3" style="max-width: 900px;">
                            <h1 class="display-1 text-white mb-md-4 animated zoomIn">@item.Nombre</h1>
                            <h3 class="text-white text-uppercase mb-3 animated slideInDown">@item.Descripcion</h3>
                            <a href="@item.Link" class="btn btn-outline-light py-md-3 px-md-5 animated slideInRight">Más Info</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="carousel-item">
                    <img class="img-fluid" width="100%" src="@item.Ruta" alt="Image">
                    <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                        <div class="p-3" style="max-width: 900px;">
                            <h1 class="display-1 text-white mb-md-4 animated zoomIn">@item.Nombre</h1>
                            <h3 class="text-white text-uppercase mb-3 animated slideInDown">@item.Descripcion</h3>
                            <a href="@item.Link" class="btn btn-outline-light py-md-3 px-md-5 animated slideInRight">Más Info</a>
                        </div>
                    </div>
                </div>
            }
        }


