<!-- Full Screen Search Start -->
<div class="modal fade" id="searchModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content" style="background: rgba(9, 30, 62, .7);">
            <div class="modal-header border-0">
                <button type="button" class="btn bg-white btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex align-items-center justify-content-center">
                <div class="input-group" style="max-width: 600px;">
                    <input type="text" class="form-control bg-transparent border-primary p-3" placeholder="Type search keyword">
                    <button class="btn btn-primary px-4"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Full Screen Search End -->
<!-- Sobre Nosotros Start -->
<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="section-title position-relative pb-3 mb-5">
                    <h5 class="fw-bold text-primary text-uppercase">Sobre Nosotros</h5>
                    <h1 class="mb-0">Grupo StartNet</h1>
                    <h3 class="mb-0">Ingenieria en Servicios Informaticos</h3>
                </div>
                <p class="mb-4">
                    STARTNET es una empresa que se dedica principalmente al desarrollo informático. Somos un grupo interdiciplinario que brindamos una amplia gama de servicios informáticos y cubrimos en forma total las necesidades de su empresa.
                    <br /><br />
                    En STARTNET somos un equipo de profesionales que desde 1999 estamos brindando soluciones y aportando valor a sus inversiones en Tecnologias de la Información y la Comunicación.
                </p>
                <div class="d-flex align-items-center mb-4 wow fadeIn" data-wow-delay="0.6s">
                    <div class="bg-primary d-flex align-items-center justify-content-center rounded" style="width: 60px; height: 60px;">
                        <i class="fa fa-phone-alt text-white"></i>
                    </div>
                    <div class="ps-4">
                        <h5 class="mb-2">Contactese a:</h5>
                        <h4 class="text-primary mb-0">3564 437465</h4>
                    </div>
                    <div class="ps-4">
                        <a href="quote.html" class="btn btn-primary py-3 px-5 mt-3 wow zoomIn" data-wow-delay="0.9s">Ver Mas+</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 img-empresa">
                <div class="position-relative h-100">
                    <br />
                    <br /><br />
                    <img class="position-absolute w-100 h-100 rounded wow zoomIn" data-wow-delay="0.9s" src="~/Data/img/Desarrollo Web.jpg" style="object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Sobre Nosotros End -->
<!-- Productos Start -->
<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
            <h5 class="fw-bold text-primary text-uppercase">Nuestros Productos</h5>
            <h1 class="mb-0">Soluciones personalizadas para su exitoso negocio</h1>
        </div>
        <div class="row g-5">

            @foreach (var item in ViewBag.Productos)
            {
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.3s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div>
                            <img class="img-fluid" src="~/Data/Imagenes/Productos/@item.NombreHome" />
                        </div>
                        <br />
                        <h6><strong>@item.Descripcion</strong></h6>
                        <a class="btn btn-lg btn-primary rounded" asp-controller="Productos" asp-action="Details" asp-route-id="@item.Id">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Productos End -->
<!-- Servicios Start -->
<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
            <h5 class="fw-bold text-primary text-uppercase">Nuestros servicios</h5>
            <h1 class="mb-0">Al servicio de su exitoso negocio</h1>
        </div>
        <div class="row g-5">
            @foreach (var item in ViewBag.Servicios)
            {
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.9s">
                    <div class="service-item bg-light rounded d-flex flex-column align-items-center justify-content-center text-center">
                        <div>
                            <img class="img-fluid" src="~/Data/Imagenes/Servicios/@item.NombreHome" />
                        </div>
                        <a class="btn btn-lg btn-primary rounded" asp-controller="Servicios" asp-action="Details" asp-route-id="@item.Id">
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Servicios End -->
<!-- Blog Start -->
<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
            <h5 class="fw-bold text-primary text-uppercase">Novedades del Blog</h5>
            <h1 class="mb-0">Lea los últimos artículos de nuestra publicación de blog</h1>
        </div>
        <div class="row g-5">
            @foreach (var item in ViewBag.Novedades)
            {
                <div class="col-lg-4 wow slideInUp" data-wow-delay="0.3s">
                    <div class="blog-item bg-light rounded overflow-hidden">
                        <div class="blog-img position-relative overflow-hidden text-center">
                            <img width="auto" height="265px" src="~/Data/Imagenes/Novedades/@item.NombreFoto">
                        </div>
                        <div class="p-4">
                            <div class="d-flex mb-3">
                                <small><i class="far fa-calendar-alt text-primary me-2"></i>@item.Fecha.ToShortDateString()</small>
                            </div>
                            <h4 class="mb-3">@item.Titulo</h4>
                            @*<p>@item.Detalle</p>*@
                            <a class="text-uppercase" asp-controller="Novedades" asp-action="Details" asp-route-id="@item.Id">Leer Más<i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!-- Blog Start -->
<!-- Clientes Start -->
<div class="container-fluid py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5 mb-5">
        <div class="section-title text-center position-relative pb-3 mb-5 mx-auto" style="max-width: 600px;">
            <h5 class="fw-bold text-primary text-uppercase">Nuestros Clientes</h5>
            <h1 class="mb-0">Clientes que nos acompañan en nuestro día a día</h1>
        </div>
        <div class="bg-white">
            <div class="owl-carousel vendor-carousel">
                @foreach (var item in ViewBag.Clientes)
                {
                    <img src="~/Data/Imagenes/LogosClientes/@item.NombreLogo" alt="">
                }
            </div>
        </div>
    </div>
</div>
<!-- Clientes End -->