<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Grupo StartNet</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="~/Data/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/Data/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/Data/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Data/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/Data/css/style.css" rel="stylesheet" />
</head>

<body>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner"></div>
    </div>
    <!-- Spinner End -->
    <!-- Topbar Start -->
    <div class="container-fluid bg-dark px-5 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-8 text-center text-lg-start mb-2 mb-lg-0">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    <small class="me-3 text-light"><i class="fa fa-map-marker-alt me-2"></i>Pje.Zanicheli 1887 3°A,San Francisco,Cordoba</small>
                    <small class="me-3 text-light"><i class="fa fa-phone-alt me-2"></i>3564 437465</small>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-inline-flex align-items-center" style="height: 45px;">
                    @*<a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href="https://twitter.com/stnt_ingenieria"><i class="fab fa-twitter fw-normal"></i></a>*@
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" target="_blank" href="https://www.facebook.com/people/StartNet-Ingenier%C3%ADa-en-Desarrollos-Inform%C3%A1ticos/100034650236906/"><i class="fab fa-facebook-f fw-normal"></i></a>
                    @*<a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" href=""><i class="fab fa-linkedin-in fw-normal"></i></a>*@
                    <a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle me-2" target="_blank" href="https://www.instagram.com/startnet.99/"><i class="fab fa-instagram fw-normal"></i></a>
                    @*<a class="btn btn-sm btn-outline-light btn-sm-square rounded-circle" href=""><i class="fab fa-youtube fw-normal"></i></a>*@
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->
    <!-- Navbar -->
    <div class="container<!---fluid--> position-relative p-0">
        <nav class="navbar navbar-expand-lg navbar-dark px-5 py-3 py-lg-0 nav-mobil">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand p-0">
                <img class="w-100" src="~/Data/img/Logotipo startnet BLANCO.png" alt="Image" width="25%" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="fa fa-bars"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto py-0">
                    <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Home</a>
                    <a asp-controller="Home" asp-action="Empresa" class="nav-item nav-link">Empresa</a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Productos</a>
                        <div class="dropdown-menu m-0">
                            @await Component.InvokeAsync("Productos")
                        </div>
                    </div>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Servicios</a>
                        <div class="dropdown-menu m-0">
                            @await Component.InvokeAsync("Servicios")
                        </div>
                    </div>
                    <a asp-controller="Clientes" asp-action="Index" class="nav-item nav-link">Clientes</a>
                    <a asp-controller="Novedades" asp-action="Index" class="nav-item nav-link">Blog</a>
                    <a asp-controller="Home" asp-action="CV" class="nav-item nav-link"><p>Envía&nbsp;tu&nbsp;CV</p></a>
                    <a target="_blank" href="https://stnt.atlassian.net/servicedesk/customer/portal/1/group/1/create/4" class="nav-item nav-link">Soporte</a>
                    <a asp-controller="Home" asp-action="Contacto" class="nav-item nav-link">Contacto</a>
                    <a asp-controller="Postulantes" asp-action="Index" class="nav-item nav-link">Postulantes</a>
                    <!--NUEVO MENU -->
                    <div class="dropdown">
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Operaciones</a>
                            <ul class="dropdown-menu m-0">
                                <a asp-controller="Provincias" asp-action="Index" class="dropdown-item">Provincias</a>    
                                <a asp-controller="Localidades" asp-action="Index" class="dropdown-item">Localidades</a>
                                <a asp-controller="Idiomas" asp-action="Index" class="dropdown-item">Idiomas</a>    
                                <a asp-controller="PuestoTrabajo" asp-action="Index" class="dropdown-item">PuestoTrabajo</a>
                                 <a asp-controller="NivelConocimientoes" asp-action="Index" class="dropdown-item">NivelConocimientoes</a>
                                <a asp-controller="ExperienciaTrabajo" asp-action="Index" class="dropdown-item">ExperienciaTrabajo</a>
                                <a asp-controller="Tecnologias" asp-action="Index" class="dropdown-item">Tecnologias</a>
                                <a asp-controller="NivelOral" asp-action="Index" class="dropdown-item">NivelOral</a>
                                <a asp-controller="NivelLectura" asp-action="Index" class="dropdown-item">NivelLectura</a>
                                <a asp-controller="NivelEscrito" asp-action="Index" class="dropdown-item">NivelEscrito</a>


                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

    </div>
    <!-- Navbar -->

    @RenderBody()

    <!-- Footer Start -->
    <div class="container-fluid bg-dark text-light mt-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container">
            <div class="row gx-5">
                <div class="col-lg-4 col-md-6 footer-about">
                    <div class="d-flex flex-column align-items-center justify-content-center text-center h-100 bg-primary p-4">
                        <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                            <!--<h1 class="m-0 text-white"><i class="fa fa-user-tie me-2"></i>Startup</h1>-->
                            <img class="w-100" src="~/Data/img/Logotipo startnet BLANCO.png" alt="Image" width="90%" />
                        </a>
                        <p class="mt-3 mb-4">"Si existe una necesidad existe una Oportunidad"</p>
                    </div>
                </div>
                <div class="col-lg-8 col-md-6">
                    <div class="row gx-5">
                        <div class="col-lg-4 col-md-12 pt-5 mb-5">
                            <div class="section-title section-title-sm position-relative pb-3 mb-4">
                                <h3 class="text-light mb-0">Contacto</h3>
                            </div>
                            <div class="d-flex mb-2">
                                <i class="bi bi-geo-alt text-primary me-2"></i>
                                <p class="mb-0">Pje.Zanicheli 1887 3°A,San Francisco,Cordoba</p>
                            </div>
                            @* <div class="d-flex mb-2">
                                <i class="bi bi-telephone text-primary me-2"></i>
                                <p class="mb-0">3564 437465</p>
                            </div> *@
                            <div class="d-flex mt-4">
                                @*<a class="btn btn-primary btn-square me-2" href="https://twitter.com/stnt_ingenieria"><i class="fab fa-twitter fw-normal"></i></a>*@
                                <a class="btn btn-primary btn-square me-2" target="_blank" href="https://www.facebook.com/people/StartNet-Ingenier%C3%ADa-en-Desarrollos-Inform%C3%A1ticos/100034650236906/"><i class="fab fa-facebook-f fw-normal"></i></a>
                                @*<a class="btn btn-primary btn-square me-2" href="#"><i class="fab fa-linkedin-in fw-normal"></i></a>*@
                                <a class="btn btn-primary btn-square" target="_blank" href="https://www.instagram.com/startnet.99/"><i class="fab fa-instagram fw-normal"></i></a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-12 pt-0 pt-lg-5 mb-5">
                            <div class="section-title section-title-sm position-relative pb-3 mb-4">
                                <h3 class="text-light mb-0">E-Mails</h3>
                            </div>
                            <div class="link-animated d-flex flex-column justify-content-start">
                                <h5 style="color:#fff">Área Ingeniería</h5>
                                <div class="d-flex mb-2">
                                    <i class="bi bi-envelope-open text-primary me-2"></i>
                                    <p class="mb-0">
                                        ingenieria@stnt.com.ar
                                    </p>
                                </div>
                                <h5 style="color:#fff">Área Web</h5>
                                <div class="d-flex mb-2">
                                    <i class="bi bi-envelope-open text-primary me-2"></i>
                                    <p class="mb-0">
                                        web@stnt.com.ar
                                    </p>
                                </div>
                                <h5 style="color:#fff">Área Comercial</h5>
                                <div class="d-flex mb-2">
                                    <i class="bi bi-envelope-open text-primary me-2"></i>
                                    <p class="mb-0">
                                        comercial@stnt.com.ar
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-12 pt-0 pt-lg-5 mb-5">
                            <div class="section-title section-title-sm position-relative pb-3 mb-4">
                                <h3 class="text-light mb-0">Enlaces</h3>
                            </div>
                            <div class="link-animated d-flex flex-column justify-content-start">
                                <a class="text-light mb-2" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-right text-primary me-2"></i>Home</a>
                                <a class="text-light mb-2" asp-controller="Home" asp-action="Empresa"><i class="bi bi-arrow-right text-primary me-2"></i>Empresa</a>
                                <a class="text-light mb-2" asp-controller="Clientes" asp-action="Index"><i class="bi bi-arrow-right text-primary me-2"></i>Clientes</a>
                                <a class="text-light mb-2" asp-controller="Novedades" asp-action="Index"><i class="bi bi-arrow-right text-primary me-2"></i>Blog</a>
                                <a class="text-light mb-2" asp-controller="Home" asp-action="CV" ><i class="bi bi-arrow-right text-primary me-2"></i>CV</a>
                                <a class="text-light mb-2" target="_blank" href="https://stnt.atlassian.net/servicedesk/customer/portal/1/group/1/create/4"><i class="bi bi-arrow-right text-primary me-2"></i>Soporte y Ayuda</a>
                                <a class="text-light" asp-controller="Home" asp-action="Contacto"><i class="bi bi-arrow-right text-primary me-2"></i>Contacto</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid text-white" style="background: #000000de; ">
        <div class="container text-center">
            <div class="row justify-content-end">
                <div class="col-lg-8 col-md-6">
                    <div class="d-flex align-items-center justify-content-center" style="height: 75px;">
                        <p class="mb-0">
                            &copy; <a class="text-white border-bottom" href="#">Grupo StartNet</a>
                            .Todos los Derechos Reservados. 	Diseñado por <a class="text-white border-bottom" href="#">Grupo StartNet</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded back-to-top"><i class="bi bi-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Data/lib/wow/wow.min.js"></script>
    <script src="~/Data/lib/easing/easing.min.js"></script>
    <script src="~/Data/lib/waypoints/waypoints.min.js"></script>
    <script src="~/Data/lib/counterup/counterup.min.js"></script>
    <script src="~/Data/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/Data/js/main.js"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>
