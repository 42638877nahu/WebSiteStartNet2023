<div>
    <a asp-action="Index">Volver</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#provinciaSelect").change(function () {

        var provinciaId = $(this).val();

        $("#localidadSelect").empty();
        $("#localidadSelect").append('<option value="">Cargando...</option>');

        $.ajax({
            url: '/Localidades/GetLocalidades',
            type: 'GET',
            data: { ProvinciaId: provinciaId },
            success: function (data) {

                $("#localidadSelect").empty();
                $("#localidadSelect").append('<option value="">Seleccione localidad</option>');

                $.each(data, function (i, loc) {
                    $("#localidadSelect").append('<option value="' + loc.id + '">' + loc.nombre + '</option>');
                });
            },
            error: function () {
                alert("Error al cargar localidades.");
            }
        });
    });
</script>