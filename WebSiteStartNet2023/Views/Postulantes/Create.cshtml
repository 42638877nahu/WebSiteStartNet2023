@model WebSiteStartNet2023.Models.ModelView.PostulanteCreateVM

@{
    ViewData["Title"] = "Nuevo Postulantes";
}

<div class="container-fluid position-relative p-0">
    <div class="container-fluid bg-primary py-5 bg-header">
        <div class="row py-5">
            <div class="col-12 pt-lg-5 mt-lg-5 text-center">
                <h1 class="display-4 text-white animated zoomIn"> Nuevo Postulante</h1>
            </div>
        </div>
    </div>
</div>

<p class="mt-3" style="text-align:center">Trabaja con nosotros y forma parte de grupo StarNet</p>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <h5>Datos Personales</h5>
    <hr />

    <div class="row">
        <div class="col-11 col-md-3 mx-3">

            <div class="form-group">
                <label asp-for="Postulante.Nombre" class="control-label"></label>
                <input asp-for="Postulante.Nombre" class="form-control" />
                <span asp-validation-for="Postulante.Nombre" class="text-danger"></span>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.Apellido" class="control-label"></label>
                <input asp-for="Postulante.Apellido" class="form-control" />
                <span asp-validation-for="Postulante.Apellido" class="text-danger"></span>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.DNI" class="control-label"></label>
                <input asp-for="Postulante.DNI" class="form-control" />
                <span asp-validation-for="Postulante.DNI" class="text-danger"></span>
            </div>
         </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.FechaNacimiento" class="control-label"></label>
            <input asp-for="Postulante.FechaNacimiento" type="date" class="form-control" />
            <span asp-validation-for="Postulante.FechaNacimiento" class="text-danger"></span>
            </div>
         </div>


    </div>
    <div class="row">
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label  class="control-label">Provincia</label>
                <select id="provinciaSelect" class="form-control">
                    <option value="">Selecione una provincia</option>
                    @foreach (var Prov in ViewBag.Provincias)
                    {
                        <option value="@Prov.Id">@Prov.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.LocalidadId" class="control-label"></label>
                <select id="localidadSelect" asp-for="Postulante.LocalidadId" class="form-control">
                    <option value="">Selecione una localidad</option>
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.CodigoArea" class="control-label"></label>
                <input asp-for="Postulante.CodigoArea" class="form-control" />
                <span asp-validation-for="Postulante.CodigoArea" class="text-danger"></span>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.TelefonoCelular" class="control-label"></label>
                <input asp-for="Postulante.TelefonoCelular" class="form-control" />
                <span asp-validation-for="Postulante.TelefonoCelular" class="text-danger"></span>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.Email" class="control-label"></label>
                <input asp-for="Postulante.Email" class="form-control" />
                <span asp-validation-for="Postulante.Email" class="text-danger"></span>
            </div>
        </div>
    </div>

    <h5 class="mt-3">Tecnologias</h5>
    <hr />

    <div class="row">
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Tecnologia</label>
                <select asp-for="TecnologiaId" class="form-control">
                    <option value="">Selecione una tecnologia</option>
                    @foreach (var Tecno in ViewBag.Tecnologias)
                    {
                        <option value="@Tecno.Id">@Tecno.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Nivel de Conocimiento</label>
                <select asp-for="NivelConocimientoId" class="form-control">
                    <option value="">Selecione un nivel de conocimiento</option>
                    @foreach (var Nivel in ViewBag.NivelesConocimiento)
                    {
                        <option value="@Nivel.Id">@Nivel.Nombre</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <h5 class="mt-3">Idiomas</h5>
    <hr />

    <div class="row">
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Idioma</label>
                <select asp-for="IdiomaId" class="form-control">
                    <option value="">Selecione un idioma</option>
                    @foreach (var Idio in ViewBag.Idiomas)
                    {
                        <option value="@Idio.Id">@Idio.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Nivel oral</label>
                <select asp-for="NivelOralId" class="form-control">
                    <option value="">Selecione un nivel oral</option>
                    @foreach (var Nivel in ViewBag.NivelesOral)
                    {
                        <option value="@Nivel.Id">@Nivel.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Nivel escritura</label>
                <select asp-for="NivelEscrituraId" class="form-control">
                    <option value="">Selecione un nivel  Escritura</option>
                    @foreach (var Nivel in ViewBag.NivelesEscritura)
                    {
                        <option value="@Nivel.Id">@Nivel.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Nivel Lectura</label>
                <select asp-for="NivelLecturaId" class="form-control">
                    <option value="">Selecione un nivel Lectura</option>
                    @foreach (var Nivel in ViewBag.NivelesLectura)
                    {
                        <option value="@Nivel.Id">@Nivel.Nombre</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <h5 class="mt-3">Puestos</h5>
    <hr />

    <div class="row">
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Puesto de trabajo</label>
                <select asp-for="PuestoTrabajoId" class="form-control">
                    <option value="">Selecione un Trabajo</option>
                    @foreach (var Puesto in ViewBag.PuestosTrabajo)
                    {
                        <option value="@Puesto.Id">@Puesto.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-11 col-md-3 mx-3">
            <div class="form-group">
                <label class="control-label">Experiencia de trabajo</label>
                <select asp-for="ExperienciaTrabajoId" class="form-control">
                    <option value="">Selecione una experiencia </option>
                    @foreach (var Exper in ViewBag.ExperienciasTrabajo)
                    {
                        <option value="@Exper.Id">@Exper.Nombre</option>
                    }
                </select>
            </div>
        </div>

    </div>

    <div class="row">   
        <div class="col-11 col-md-6 mx-3">
            <div class="form-group">
                <label asp-for="Postulante.ArchivoCVFile" class="control-label"></label>
                <input asp-for="Postulante.ArchivoCVFile" class="form-control" type="file" />
                <span asp-validation-for="Postulante.ArchivoCVFile" class="text-danger"></span>
            </div>
        </div>        
    </div>
    
    <div class="col-2 col-md-4 mt-3 mx-3">
        <div class="form-group">
            <input type="submit" value="Crear" class="btn btn-primary" />
            <a asp-action="Index">Volver</a>
        </div>
    </div>
</form>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#provinciaSelect").change(function () {

        var provinciaId = $(this).val();

        $("#localidadSelect").empty();
        $("#localidadSelect").append('<option value="">Cargando...</option>');

        $.ajax({
            url: '/Localidades/GetLocalidades',
            type: 'GET',
            data: { ProvinciaId: provinciaId },
            success: function (data) {

                $("#localidadSelect").empty();
                $("#localidadSelect").append('<option value="">Seleccione localidad</option>');

                $.each(data, function (i, loc) {
                    $("#localidadSelect").append('<option value="' + loc.id + '">' + loc.nombre + '</option>');
                });
            },
            error: function () {
                alert("Error al cargar localidades.");
            }
        });
    });
</script>