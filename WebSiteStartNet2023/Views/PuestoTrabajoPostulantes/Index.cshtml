@model IEnumerable<WebSiteStartNet2023.Models.PuestoTrabajoPostulante>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Postulante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuestoTrabajo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExperienciaTrabajo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Postulante.Apellido)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PuestoTrabajo.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExperienciaTrabajo.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
